DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
ADMIN_URL=manage
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=sonyashnyk_db
DB_USER=sonyashnyk
DB_PASSWORD=sonyashnyk_dev_pass
DB_HOST=127.0.0.1
DB_PORT=5432

# Публічний URL сайту (для Monopay redirectUrl / webHookUrl)
SITE_URL=http://127.0.0.1:8000
# Опційно: якщо задано — має пріоритет над SITE_URL для callback
# PUBLIC_BASE_URL=https://sonjashnik.ua

# Monobank Acquiring (токен з web.monobank.ua або тестовий з api.monobank.ua)
MONOPAY_TOKEN=

# Нова Пошта — без ключа: ручне введення міста/відділення
NOVA_POSHTA_API_KEY=

# Укрпошта (production). Address classifier = Bearer eCom.
UKRPOSHTA_BEARER_ECOM=
UKRPOSHTA_BEARER_STATUS=
UKRPOSHTA_COUNTERPARTY_UUID=
UKRPOSHTA_COUNTERPARTY_TOKEN=
# Після bootstrap_ukrposhta_sender:
UKRPOSHTA_SENDER_UUID=
UKRPOSHTA_SENDER_ADDRESS_ID=
UKRPOSHTA_DEFAULT_WEIGHT=1000
UKRPOSHTA_DEFAULT_LENGTH=30
UKRPOSHTA_SHIPMENT_TYPE=STANDARD
# Дані відправника лише для bootstrap (разово):
# UKRPOSHTA_SENDER_POSTCODE=
# UKRPOSHTA_SENDER_PHONE=
# UKRPOSHTA_SENDER_NAME=
# UKRPOSHTA_SENDER_TYPE=PRIVATE_ENTREPRENEUR
# UKRPOSHTA_SENDER_TIN=
# UKRPOSHTA_SENDER_CITY=
# UKRPOSHTA_SENDER_STREET=
# UKRPOSHTA_SENDER_HOUSE=

# Navkolo DNTrade — токен з Опції → Інтеграції → API DNTrade
DNTRADE_API_KEY=
# Склад для каталогу: Перемоги 5 (без офлайн електро/буд)
# 9043f685-1aa5-49d5-af2d-c8777cf814f5
DNTRADE_STORE_ID=9043f685-1aa5-49d5-af2d-c8777cf814f5
DNTRADE_BASE_URL=https://api.dntrade.com.ua
