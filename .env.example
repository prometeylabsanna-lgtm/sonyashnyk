DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
ADMIN_URL=manage
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=sonyashnyk_db
DB_USER=sonyashnyk
DB_PASSWORD=sonyashnyk_dev_pass
DB_HOST=127.0.0.1
DB_PORT=5432

# Публічний URL сайту (для LiqPay result_url / server_url)
SITE_URL=http://127.0.0.1:8000

# LiqPay — sandbox спочатку; без ключів працює mock-оплата
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=True

# Нова Пошта — без ключа: ручне введення міста/відділення
NOVA_POSHTA_API_KEY=

# Navkolo DNTrade — токен з Опції → Інтеграції → API DNTrade
DNTRADE_API_KEY=
# Склад для каталогу (див. python3 manage.py sync_dntrade --list-stores)
# Рекомендація: Основний = A8C66C69-8DDC-4711-96EC-1D079C3FD303
DNTRADE_STORE_ID=
DNTRADE_BASE_URL=https://api.dntrade.com.ua
