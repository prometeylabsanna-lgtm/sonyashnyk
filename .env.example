DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=sonyashnyk_db
DB_USER=sonyashnyk
DB_PASSWORD=sonyashnyk_dev_pass
DB_HOST=127.0.0.1
